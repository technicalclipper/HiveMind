# Copy to .env and fill in. Never commit .env.

# --- NEAR ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
HIVEMIND_CONTRACT_ID=
HIVE_TOKEN_CONTRACT_ID=
OWNER_ACCOUNT_ID=
EVALUATOR_ACCOUNT_ID=
OPERATOR_ACCOUNT_ID=

# Private keys for service accounts (evaluator / operator). Format: ed25519:...
EVALUATOR_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=

# --- ML ---
BASE_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
HF_TOKEN=

# --- Storage (IPFS via Pinata) ---
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --- Services ---
EVALUATOR_WS_PORT=8765
INFERENCE_PORT=8000
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_EVALUATOR_WS=ws://localhost:8765
NEXT_PUBLIC_INFERENCE_URL=http://localhost:8000
